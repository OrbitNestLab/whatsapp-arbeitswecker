# Niemals echte Werte einchecken. Werte ohne eckige Klammern lokal eintragen.
META_VERIFY_TOKEN=[META_VERIFY_TOKEN]
META_APP_SECRET=[META_APP_SECRET]
ALLOWED_SENDER_WA_ID=[WHATSAPP_SENDER_ID_GUENNA]
BRIDGE_API_KEY=[BRIDGE_API_KEY]
TIMEZONE=Europe/Berlin
DATABASE_PATH=/data/arbeitswecker.db
# Optional: vollständige Home-Assistant-Webhook-URL für sofortige Aktualisierung.
HA_WEBHOOK_URL=[HA_WEBHOOK_URL]
HA_WEBHOOK_TIMEOUT_SECONDS=10
